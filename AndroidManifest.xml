<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.latent.camera" android:versionCode="68" android:versionName="0.35.1">
    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- the Shooting test saves the system log, for the camera service's reason when it refuses the capture hook -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <application android:label="@string/app_name" android:icon="@drawable/icon" android:allowBackup="false">
        <!-- Sony's catalogue and image libraries, for the camera roll test. Optional: the app runs without them. -->
        <uses-library android:name="sony.cameraex" android:required="false" />
        <uses-library android:name="com.sony.scalar.stillPlay" android:required="false" />
        <uses-library android:name="com.sony.scalar.database_library" android:required="false" />
        <activity android:name=".MainActivity" android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- a blank screen, in its own process, while Latent ends and starts again (the camera's image memory comes back only then) -->
        <activity android:name=".Relaunch" android:process=":relaunch" android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
